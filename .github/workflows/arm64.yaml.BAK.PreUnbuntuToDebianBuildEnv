name: Build ARM64 DEB

on:
  workflow_dispatch:

jobs:
  build-deb:
    runs-on: ubuntu-latest
    steps:
      - name: Check out code
        uses: actions/checkout@v4

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3

      - name: Build Static ARM64 DEB via Container
        run: |
          docker run --rm \
            --platform linux/arm64 \
            -v ${{ github.workspace }}:/workspace \
            -w /workspace \
            arm64v8/ubuntu:24.04 sh -c "
              apt-get update && \
              apt-get install -y build-essential libbsd-dev libcjson-dev libcurl4-openssl-dev dpkg-dev && \
              make LDFLAGS='-static -lbsd -lcjson -lcurl' deb
            "

      - name: Upload DEB artifact
        uses: actions/upload-artifact@v4
        with:
          name: deb-package-arm64
          path: deb/*.deb
